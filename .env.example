# ---- Database (Supabase / Postgres) ----
DATABASE_URL="postgresql://user:pass@host:5432/macrodelta?schema=public"

# ---- App ----
APP_BASE_URL="http://localhost:3000"

# ---- Token encryption (AES-256-GCM) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="<64-hex-chars = 32 bytes>"

# ---- Fitbit Web API (OAuth 2.0, Authorization Code + PKCE) ----
FITBIT_CLIENT_ID="<from dev.fitbit.com>"
FITBIT_CLIENT_SECRET="<from dev.fitbit.com>"
# Must EXACTLY match the callback registered on dev.fitbit.com:
FITBIT_REDIRECT_URI="http://localhost:3000/api/fitbit/callback"

# ---- Google Gemini ----
GEMINI_API_KEY="<from ai.google.dev>"

# ---- Supabase (Auth + Storage). From Project Settings → API. ----
# Public (safe to expose to the browser). REQUIRED for real auth + route
# middleware — until both are set, login is disabled and middleware no-ops.
# Enable the Email provider in Supabase → Authentication → Providers.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"
# Server-only secret — enables meal-image uploads to the 'meal-images' bucket.
# NEVER expose this to the client. Create a public bucket named 'meal-images'.
SUPABASE_SERVICE_ROLE_KEY="<service_role secret key>"
