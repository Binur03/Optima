// MacroDelta — Prisma schema (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer, 6543) for app runtime
  directUrl = env("DIRECT_URL")   // direct (5432) for migrations / db push
}

enum Goal {
  CUT
  MAINTAIN
  BULK
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum LogSource {
  AI_IMAGE
  MANUAL
  TEXT_SEARCH
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  goal       Goal      @default(MAINTAIN)
  goalDelta  Int       @default(0) @map("goal_delta") // active applied delta
  cutDelta   Int       @default(-500) @map("cut_delta")  // user's custom Cut offset
  bulkDelta  Int       @default(300) @map("bulk_delta")  // user's custom Bulk offset
  timezone   String    @default("UTC") // IANA tz, e.g. America/Los_Angeles
  heightCm   Int?      @map("height_cm")
  weightKg   Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  sex        Sex?
  birthDate  DateTime? @map("birth_date") @db.Date
  age        Int?
  createdAt  DateTime  @default(now()) @map("created_at")

  // Universal tracking: wearable users get a rolling TDEE; manual users get a
  // Mifflin-St Jeor estimate stored as manualTdee.
  hasWearable   Boolean @default(false) @map("has_wearable")
  manualTdee    Int?    @map("manual_tdee")
  activityLevel String? @map("activity_level") // sedentary|light|moderate|active|very_active

  // User-chosen daily calorie target. Null → maintenance + goal offset.
  customCalories Int? @map("custom_calories")

  // Macro goals (grams). Null → derived from the calorie target on the fly.
  targetProtein Int? @map("target_protein")
  targetCarbs   Int? @map("target_carbs")
  targetFat     Int? @map("target_fat")

  // Cached weekly AI coaching insight (regenerated at most once/week).
  weeklyInsight   String?   @map("weekly_insight")
  weeklyInsightAt DateTime? @map("weekly_insight_at")

  // Gamification. totalXP/level are a cache of SUM(xp_events.amount) — the
  // ledger is the source of truth, so these can always be recomputed.
  currentStreak Int @default(0) @map("current_streak")
  highestStreak Int @default(0) @map("highest_streak")
  totalXP       Int @default(0) @map("total_xp")
  level         Int @default(1)

  fitbitToken FitbitToken?
  dailyLogs   DailyLog[]
  foodLogs    FoodLog[]

  // Training + progress (relation fields only — no columns on users)
  workoutPrograms WorkoutProgram[]
  workoutSplits  WorkoutSplit[]
  exercises      Exercise[]
  workoutLogs    WorkoutLog[]
  progressPhotos ProgressPhoto[]
  weightLogs     WeightLog[]
  achievements   Achievement[]
  xpEvents       XpEvent[]

  @@map("users")
}

// ---------- Gamification ----------

// One row per unlocked badge. The catalog (titles, rules) lives in
// lib/achievements.ts; `key` is e.g. "streak_7" or "bench_225".
model Achievement {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  @@unique([userId, key])
  @@map("achievements")
}

// XP ledger. `key` names the reason exactly once ("meal:<foodLogId>",
// "protein:2026-10-03", "ach:streak_7"), so re-evaluating never double-awards.
model XpEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  amount    Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, key])
  @@map("xp_events")
}

// ---------- Lift tracker ----------

// A training program (e.g. "Push / Pull / Legs", "Arnold Split") — an ordered
// set of training days. Exactly one is active per user: the one Train shows.
model WorkoutProgram {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean        @default(false) @map("is_active")
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  splits    WorkoutSplit[]

  @@unique([userId, name])
  @@map("workout_programs")
}

// One training day within a program ("Push", "Chest & Back", …).
model WorkoutSplit {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String?         @map("program_id")
  program   WorkoutProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String // "Push", "Pull", "Legs", …
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  exercises Exercise[] // legacy single-split link; membership lives in `items`
  items     SplitExercise[]

  // Day names are unique within a program, so PPL and Arnold can both have "Legs".
  @@unique([programId, name])
  @@index([userId])
  @@map("workout_splits")
}

// An exercise is one lift with one history (e.g. "Bench Press"); it can sit in
// any number of splits, so Push and Chest & Back can both include it.
model Exercise {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  splitId   String?         @map("split_id") // legacy — superseded by split_exercises
  split     WorkoutSplit?   @relation(fields: [splitId], references: [id], onDelete: SetNull)
  name      String
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  logs      WorkoutLog[]
  splits    SplitExercise[]

  @@unique([userId, name])
  @@map("exercises")
}

model SplitExercise {
  id         String       @id @default(uuid())
  splitId    String       @map("split_id")
  split      WorkoutSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  exerciseId String       @map("exercise_id")
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sortOrder  Int          @default(0) @map("sort_order")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([splitId, exerciseId])
  @@map("split_exercises")
}

// One row per exercise per day; sets append atomically.
model WorkoutLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String   @map("exercise_id")
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  logDate    DateTime @map("log_date") @db.Date
  sets       Json // [{ "weight": 225, "reps": 8 }] — weight in lb
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, exerciseId, logDate])
  @@map("workout_logs")
}

// ---------- Progress ----------

model ProgressPhoto {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storagePath String   @unique @map("storage_path") // "<auth.uid()>/<uuid>.jpg" in the private bucket
  takenOn     DateTime @map("taken_on") @db.Date
  weightLb    Decimal? @map("weight_lb") @db.Decimal(6, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, takenOn])
  @@map("progress_photos")
}

model WeightLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate   DateTime @map("log_date") @db.Date
  weightLb  Decimal  @map("weight_lb") @db.Decimal(6, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, logDate])
  @@map("weight_logs")
}

model FitbitToken {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken          String   @map("access_token")  // encrypted at rest
  refreshToken         String   @map("refresh_token")  // encrypted at rest
  scope                String
  fitbitUserId         String   @map("fitbit_user_id")
  accessTokenExpiresAt DateTime @map("access_token_expires_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("fitbit_tokens")
}

model DailyLog {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate           DateTime @map("log_date") @db.Date
  caloriesOut       Int?     @map("calories_out")
  steps             Int?
  activeZoneMinutes Int?     @map("active_zone_minutes")
  syncedAt          DateTime @default(now()) @map("synced_at")

  @@unique([userId, logDate])
  @@index([userId, logDate])
  @@map("daily_logs")
}

model FoodLog {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate     DateTime  @map("log_date") @db.Date
  foodName    String    @map("food_name")
  calories    Int
  proteinG    Decimal   @default(0) @map("protein_g") @db.Decimal(6, 2)
  carbsG      Decimal   @default(0) @map("carbs_g")   @db.Decimal(6, 2)
  fatG        Decimal   @default(0) @map("fat_g")     @db.Decimal(6, 2)
  source      LogSource @default(AI_IMAGE)
  aiEstimated Boolean   @default(false) @map("ai_estimated")
  imageUrl    String?   @map("image_url")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, logDate])
  @@map("food_logs")
}
